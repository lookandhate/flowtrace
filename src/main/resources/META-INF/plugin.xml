<idea-plugin url="https://github.com/lookandhate/flowtrace">
    <id>io.github.lookandhate.flowtrace</id>
    <name>Flow Trace for Go</name>
    <vendor url="https://github.com/lookandhate" email="36508332+lookandhate@users.noreply.github.com">lookandhate</vendor>

    <!-- description и change-notes подставляются из README.md и CHANGELOG.md при сборке (build.gradle.kts). -->

    <depends>com.intellij.modules.lang</depends>
    <depends>org.jetbrains.plugins.go</depends>
    <dependencies>
        <module name="intellij.go.impl"/>
    </dependencies>

    <resource-bundle>messages.FlowTraceBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="FlowTrace" anchor="bottom" icon="AllIcons.Toolwindows.ToolWindowHierarchy"
                    factoryClass="io.github.lookandhate.flowtrace.ui.FlowToolWindowFactory" canCloseContents="true"/>
    </extensions>

    <actions>
        <group id="FlowTrace.EditorGroup">
            <separator/>
            <action id="FlowTrace.Origins" class="io.github.lookandhate.flowtrace.actions.TraceOriginsAction">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt shift O"/>
            </action>
            <action id="FlowTrace.Sinks" class="io.github.lookandhate.flowtrace.actions.TraceSinksAction">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt shift U"/>
            </action>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
